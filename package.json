{
  "name": "@creatioart/template-nodejs-graphql-service",
  "version": "1.0.0",
  "private": true,
  "description": "CreatioART - Template Node.js GraphQL Service able to handle API's request",
  "keywords": [
    "template",
    "service",
    "nodejs",
    "graphql"
  ],
  "homepage": "https://docs.creatioart.com/template/template-nodejs-graphql-service",
  "repository": {
    "type": "git",
    "url": "https://creatioart@dev.azure.com/creatioart/template/_git/template-nodejs-graphql-service"
  },
  "license": "Apache-2.0",
  "author": "CreatioART - CreatioART Support <support@creatioart.com>",
  "type": "module",
  "scripts": {
    "build": "npm-run-all build:*",
    "build:clean": "rimraf ./build/",
    "build:schema": "mkdir build && cp src/modules/**/schema/*.graphql build/",
    "build:format": "npm run mdformat",
    "build:codegen": "npm run codegen",
    "build:lint": "npx eslint ./src/** --max-warnings=0 --config=.eslintrc.json",
    "build:compile": "tsc",
    "build:locale": "npm run locale",
    "mdformat": "npx prettier --write *.md",
    "codegen": "graphql-codegen-esm --config codegen.yml",
    "postcodegen": "npm-run-all postcodegen:*",
    "postcodegen:esm": "replace-in-file ../generated.types/graphql ../generated.types/graphql.js src/modules/**/generated.types/module.types.ts",
    "postcodegen:prettier": "npx prettier --write build/*.graphql src/generated.types/graphql.ts src/modules/**/generated.types/module.types.ts",
    "prewatch": "npm run build",
    "watch": "npm run prewatch -- -w",
    "start": "node ./build/app.js",
    "dev": "npm run build && cross-env APP_ENV=local npm run start",
    "debug": "npm run build && cross-env DEBUG=true APP_ENV=local npm run start",
    "start:watch": "npm run watch & nodemon ./build/app.js",
    "test": "npm-run-all test:*",
    "test:build": "npm run build",
    "test:clean": "rimraf ./coverage/",
    "test:lint": "npx eslint ./test/** --max-warnings=0 --config=.eslintrc.json",
    "test:start": "cross-env NODE_OPTIONS=--experimental-vm-modules NODE_NO_WARNINGS=1 jest --config=jest.config.json --no-cache --silent",
    "tdd": "nodemon -e ts --watch ./test --exec \"npm run test\"",
    "prepare": "husky",
    "locale": "npx locale-compiler -s ./locales/source -t ./locales/compiled",
    "docs": "npm-run-all docs:*",
    "docs:visualize-imports": "npx madge --image docs/imports.svg --ts-config tsconfig.json src/app.ts"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx}": "npx eslint ./src --max-warnings=0 --config=.eslintrc.json && npm run locale",
    "*.md": "npx prettier --write *.md"
  },
  "nodemonConfig": {
    "exec": "node_modules/.bin/ts-node ./src/index.ts",
    "ext": "ts",
    "watch": [
      "src"
    ]
  },
  "dependencies": {
    "@apollo/server": "^4.11.3",
    "@creatioart-js/express-core": "^1.3.1",
    "@creatioart-js/express-error": "^1.3.0",
    "@creatioart-js/express-error-handler": "^1.3.0",
    "@creatioart-js/express-logging": "^1.3.0",
    "@creatioart-js/express-security": "^1.3.0",
    "@creatioart-js/express-service": "^1.3.0",
    "@creatioart-js/express-storage": "^1.3.0",
    "@creatioart-js/graphql-core": "^0.7.0",
    "@creatioart-js/graphql-error": "^0.4.0",
    "@graphql-codegen/graphql-modules-preset": "^4.0.15",
    "@graphql-tools/graphql-file-loader": "^8.0.17",
    "@graphql-tools/load": "^8.0.17",
    "@graphql-tools/schema": "^10.0.21",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "compression": "^1.8.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "glob": "^11.0.1",
    "got": "^14.4.6",
    "graphql": "^16.x.x",
    "graphql-middleware": "^6.1.35",
    "graphql-modules": "^3.0.0",
    "graphql-parse-resolve-info": "^4.13.0",
    "graphql-scalars": "^1.24.1",
    "graphql-subscriptions": "^3.0.0",
    "graphql-tag": "^2.12.6",
    "graphql-ws": "^6.0.4",
    "i18n": "^0.15.1",
    "morgan": "^1.10.0",
    "reflect-metadata": "0.2.2",
    "typedi": "^0.10.0",
    "uuid": "^11.1.0",
    "winston": "3.17.0",
    "ws": "^8.18.1"
  },
  "devDependencies": {
    "@graphql-codegen/cli": "5.0.5",
    "@graphql-codegen/typescript": "^4.1.5",
    "@graphql-codegen/typescript-resolvers": "^4.4.4",
    "@graphql-eslint/eslint-plugin": "^4.3.0",
    "@jest/globals": "^29.7.0",
    "@npm/types": "^2.0.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/eslint": "<9.0.0",
    "@types/express": "^5.0.0",
    "@types/glob": "^8.1.0",
    "@types/i18n": "^0.13.12",
    "@types/jest": "^29.5.14",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.10",
    "@types/uuid": "^10.0.0",
    "@types/validator": "^13.12.2",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "cross-env": "^7.0.3",
    "eslint": "<9.0.0",
    "eslint-config-prettier": "^10.1.1",
    "eslint-plugin-graphql-schema": "^2.0.3",
    "eslint-plugin-n": "^17.16.2",
    "eslint-plugin-promise": "^7.2.1",
    "husky": "^9.1.7",
    "jest": "^29.7.0",
    "lint-staged": "^15.4.3",
    "madge": "^8.0.0",
    "nock": "^14.0.1",
    "nodemon": "^3.1.9",
    "npm-run-all": "^4.1.5",
    "prettier": "^3.5.3",
    "replace-in-file": "^8.3.0",
    "ts-jest": "^29.2.6",
    "ts-node": "^10.9.2",
    "typedoc": "^0.27.9",
    "typescript": "^5.8.2"
  },
  "engines": {
    "node": "20.x.x"
  }
}
